{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EasybotCE/easybotce/blob/main/api/protocol/endpoint.schema.json",
  "title": "EasybotCE experimental endpoint protocol 0.1.0",
  "description": "Live CE WebSocket protocol. Authentication and capability checks are enforced by the Hub. Accepted means queued, not remote execution or durable delivery.",
  "oneOf": [
    {
      "$ref": "#/$defs/Hello"
    },
    {
      "$ref": "#/$defs/Welcome"
    },
    {
      "$ref": "#/$defs/Error"
    },
    {
      "$ref": "#/$defs/Publish"
    },
    {
      "$ref": "#/$defs/Delivery"
    },
    {
      "$ref": "#/$defs/Accepted"
    }
  ],
  "$defs": {
    "Hello": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "id",
        "type",
        "payload"
      ],
      "properties": {
        "v": {
          "const": "0.1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "type": {
          "const": "session.hello"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint_id",
            "endpoint_type",
            "versions",
            "capabilities"
          ],
          "properties": {
            "endpoint_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "endpoint_type": {
              "enum": [
                "mc-server",
                "chat-bot",
                "plugin"
              ]
            },
            "versions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              }
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "Welcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "id",
        "type",
        "payload",
        "reply_to"
      ],
      "properties": {
        "v": {
          "const": "0.1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "type": {
          "const": "session.welcome"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_id",
            "version",
            "capabilities",
            "heartbeat_interval_ms"
          ],
          "properties": {
            "session_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "version": {
              "const": "0.1.0"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
              },
              "uniqueItems": true
            },
            "heartbeat_interval_ms": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 300000
            }
          }
        },
        "reply_to": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "id",
        "type",
        "payload"
      ],
      "properties": {
        "v": {
          "const": "0.1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "type": {
          "const": "session.error"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "enum": [
                "invalid_message",
                "unsupported_version",
                "permission_denied",
                "internal_error"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          }
        },
        "reply_to": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    },
    "Publish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "id",
        "type",
        "payload"
      ],
      "properties": {
        "v": {
          "const": "0.1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "type": {
          "const": "message.publish"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channel_id",
            "sender_id",
            "sender_name",
            "text"
          ],
          "properties": {
            "channel_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "sender_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "sender_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        }
      }
    },
    "Delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "id",
        "type",
        "payload"
      ],
      "properties": {
        "v": {
          "const": "0.1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "type": {
          "const": "message.deliver"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "binding_id",
            "source_endpoint_id",
            "source_message_id",
            "source_channel_id",
            "channel_id",
            "sender_id",
            "sender_name",
            "text"
          ],
          "properties": {
            "binding_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "source_endpoint_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "source_message_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "source_channel_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "channel_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "sender_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "sender_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "text": {
              "type": "string",
              "minLength": 0,
              "maxLength": 2048
            }
          }
        }
      }
    },
    "Accepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "id",
        "type",
        "payload",
        "reply_to"
      ],
      "properties": {
        "v": {
          "const": "0.1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "type": {
          "const": "message.accepted"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "queued",
            "filtered",
            "dropped",
            "duplicate"
          ],
          "properties": {
            "queued": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200
            },
            "filtered": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200
            },
            "dropped": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200
            },
            "duplicate": {
              "type": "boolean"
            }
          }
        },
        "reply_to": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "description": "queued + filtered + dropped must be <= 200 (additional runtime constraint). Queue acknowledgement only."
    }
  }
}
